# ==============================================================================
# VaultGuard Backend Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure values before starting the application.
#
# FOR LOCAL DEVELOPMENT:
#   NODE_ENV=development
#   PORT=5000
#   MONGO_URI=mongodb://127.0.0.1:27017/vaultguard
#   JWT_SECRET=replace_with_a_cryptographically_secure_random_string_32_chars_min
#   VAULT_ADDR=http://127.0.0.1:8200
#   VAULT_APP_TOKEN=replace_with_restricted_app_token
#   CORS_ORIGIN=http://localhost:5173
#
# FOR VERCEL PRODUCTION (Set in Vercel Project Settings -> Environment Variables):
#   NODE_ENV=production
#   MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/vaultguard?retryWrites=true&w=majority
#   JWT_SECRET=<strong-random-secret-at-least-32-characters>
#   VAULT_ADDR=https://<vault-host>:8200
#   VAULT_APP_TOKEN=<restricted-application-token-from-vaultguard-app-policy>
#   VAULT_KV_MOUNT=secret
#   CORS_ORIGIN=https://<your-frontend-project>.vercel.app
#   COOKIE_SAMESITE=lax
# ==============================================================================

PORT=5000
NODE_ENV=development

# MongoDB Connection String (Atlas URI required in production)
MONGO_URI=mongodb://127.0.0.1:27017/vaultguard

# JWT Authentication (Minimum 32 random characters required across all environments)
JWT_SECRET=replace_with_a_cryptographically_secure_random_string_32_chars_min
JWT_EXPIRES_IN=8h
COOKIE_SAMESITE=lax

# HashiCorp Vault Secrets Engine Configuration (HTTPS endpoint required in production)
VAULT_ADDR=http://127.0.0.1:8200
# Restricted Application Token (Generated with vaultguard-app least-privilege policy)
# Do NOT use the root master token here
VAULT_APP_TOKEN=replace_with_restricted_app_token
VAULT_KV_MOUNT=secret

# Optional: Path to the Vault file audit log device for health telemetry (Local/Docker only)
VAULT_AUDIT_LOG_PATH=../vault/logs/vault_audit.log

# Frontend CORS Origin (Vercel frontend domain required in production)
CORS_ORIGIN=http://localhost:5173
