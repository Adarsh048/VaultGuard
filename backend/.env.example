# VaultGuard Environment Configuration Template
# Copy this file to .env and configure values before starting the application

PORT=5000
NODE_ENV=development

# MongoDB Connection String
MONGO_URI=mongodb://127.0.0.1:27017/vaultguard

# JWT Authentication (Minimum 32 random characters required)
JWT_SECRET=replace_with_a_cryptographically_secure_random_string_32_chars_min
JWT_EXPIRES_IN=8h
COOKIE_SAMESITE=lax

# HashiCorp Vault Community Edition Configuration
VAULT_ADDR=http://127.0.0.1:8200
# Restricted Application Token (Generated with vaultguard-app least-privilege policy)
# Do NOT use the root master token here
VAULT_APP_TOKEN=replace_with_restricted_app_token
VAULT_KV_MOUNT=secret

# Optional: Path to the Vault file audit log device for health telemetry
# In Docker, this is mounted at /vault/logs/vault_audit.log
VAULT_AUDIT_LOG_PATH=../vault/logs/vault_audit.log

# Frontend CORS Origin
CORS_ORIGIN=http://localhost:5173
