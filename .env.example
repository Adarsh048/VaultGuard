# ==============================================================================
# VaultGuard - Docker Compose Root Environment Configuration
# ==============================================================================
# Copy this file to .env before running docker compose commands.
#
# STAGED STARTUP INSTRUCTIONS:
# 1. Copy this template:
#      cp .env.example .env
# 2. Set strong initial secrets below:
#      VAULT_DEV_ROOT_TOKEN_ID=<strong_random_admin_token>
#      JWT_SECRET=<strong_random_jwt_secret_min_32_chars>
# 3. Stage 1: Start core storage and secrets engine:
#      docker compose up -d mongodb vault
# 4. Stage 2: Initialize Vault policy and mint restricted application token:
#      ./vault/scripts/init-vault.sh "$VAULT_DEV_ROOT_TOKEN_ID"
#    (or on Windows PowerShell: .\vault\scripts\init-vault.ps1 -VaultRootToken "$VAULT_DEV_ROOT_TOKEN_ID")
# 5. Stage 3: Paste the generated application token below as VAULT_APP_TOKEN in .env.
# 6. Stage 4: Start application services:
#      docker compose up -d backend frontend
# ==============================================================================

# Vault Administrative Initialization Token (Root bootstrap only)
VAULT_DEV_ROOT_TOKEN_ID=replace_with_secure_admin_token_for_initial_bootstrap

# Backend JWT Secret (Minimum 32 random characters required across all environments)
JWT_SECRET=replace_with_a_cryptographically_secure_random_string_32_chars_min

# Restricted Application Identity Token (Minted via init-vault script with vaultguard-app policy)
VAULT_APP_TOKEN=replace_with_minted_app_token_from_stage_2

