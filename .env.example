# ==============================================================================
# VaultGuard - Docker Compose Root Environment Configuration (Persistent Mode)
# ==============================================================================
# Copy this file to .env before running docker compose commands.
#
# STAGED STARTUP INSTRUCTIONS (Persistent Non-Dev Storage):
# 1. Copy this template:
#      cp .env.example .env
# 2. Configure JWT_SECRET below:
#      JWT_SECRET=<strong_random_jwt_secret_min_32_chars>
# 3. Stage 1: Start core storage and Vault services:
#      docker compose up -d mongodb vault
# 4. Stage 2: Initialize and unseal persistent Vault:
#      powershell -ExecutionPolicy Bypass -File .\vault\scripts\init-vault-persistent.ps1
#      powershell -ExecutionPolicy Bypass -File .\vault\scripts\unseal-vault.ps1
# 5. Stage 3: Configure VaultGuard AppRole:
#      powershell -ExecutionPolicy Bypass -File .\vault\scripts\configure-vaultguard-approle.ps1
# 6. Stage 4: Paste the generated VAULT_ROLE_ID and VAULT_SECRET_ID below in .env.
# 7. Stage 5: Start application services:
#      docker compose up -d backend frontend
# ==============================================================================

# Backend JWT Secret (Minimum 32 random characters required across all environments)
JWT_SECRET=replace_with_a_cryptographically_secure_random_string_32_chars_min

# AppRole Authentication Credentials (Provisioned via configure-vaultguard-approle.ps1)
VAULT_ROLE_ID=
VAULT_SECRET_ID=

# Optional fallback application token
VAULT_APP_TOKEN=

